@startuml
title Модуль async — текущая карта компонентов

left to right direction
<style>
document {
  BackgroundColor #FFFFFF
}
title {
  FontSize 16
  FontColor #111111
}
</style>

package "shuttle::async" {
  component "API задач" as TaskApi
  component "Динамически выделяемое\nобщее состояние задачи" as CoroutineState
  component "API исполнителей" as ExecutorApi
  component "Исполнитель с пулом потоков" as ThreadPool
  component "Однопоточный исполнитель" as OneThread
  component "Область корутин /\nобъединяемая область" as Scopes
  component "API ошибок" as Errors

  TaskApi --> CoroutineState : перемещаемые promise/future и состояние результата
  TaskApi --> Scopes : владение при запуске
  TaskApi --> ExecutorApi : планирование / возобновление
  Scopes --> TaskApi : дочерние задачи и задача объединения
  Scopes --> ExecutorApi : планирование продолжений
  ThreadPool ..|> ExecutorApi
  OneThread ..|> ExecutorApi
  ThreadPool --> CoroutineState : корутина-диспетчер
  OneThread --> CoroutineState : корутина-диспетчер
  TaskApi ..> Errors : запуск / результат
  ExecutorApi ..> Errors : execute / create
  Scopes ..> Errors : запуск / настройка объединения
}

cloud "Стандартная библиотека C++23\nкорутины, потоки, атомарные операции,\nexpected, jthread" as Std
component "moodycamel::ConcurrentQueue" as ConcurrentQueue
component "mimalloc" as Mimalloc
component "Потребитель ShuttleEngine" as Engine
component "Планируется: асинхронный ввод-вывод Win32" as WinIO #LightYellow

ExecutorApi ..> Std
ThreadPool ..> ConcurrentQueue
OneThread ..> ConcurrentQueue
CoroutineState ..> Mimalloc : выделение памяти для корутины
ThreadPool ..> Mimalloc : выделение памяти для исполнителя / контекста
OneThread ..> Mimalloc : выделение памяти для исполнителя
Engine ..> TaskApi : использует публичный API
WinIO ..> ExecutorApi : предлагаемое планирование завершений

note right of TaskApi
  Текущий исходный код включает исполнители, задачи, области,
  кооперативную отмену и ошибки на основе результата.
  Таймер, API ввода-вывода и AsyncFlow здесь не реализованы.
  Асинхронный ввод-вывод Win32 включён в планы, но не реализован.
end note
@enduml
