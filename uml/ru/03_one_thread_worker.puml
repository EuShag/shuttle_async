@startuml
title OneThreadExecutor — очередь, диспетчеризация и остановка
<style>
document {
  BackgroundColor #FFFFFF
  BoxPadding 10
  ParticipantPadding 10
}
title {
  FontSize 16
  FontColor #111111
}
</style>

actor "Отправитель(и)" as Submitter
participant "Однопоточный исполнитель" as Executor
queue "Параллельная очередь" as Queue
participant "Уведомитель" as Notifier
participant "Выделенный рабочий поток" as Worker
participant "Корутина-диспетчер" as Dispatcher
participant "Токен потребителя" as ConsumerToken
participant "Корутина задачи" as Task

== Запуск ==
Executor -> Worker : создать выделенный поток
Worker -> Worker : установить контекст исполнителя в TLS
Worker -> Dispatcher : запустить корутину-диспетчер
Dispatcher -> ConsumerToken : создать в потоке-потребителе
Worker --> Executor : начальное согласование завершено

== Отправка ==
Submitter -> Executor : execute(handle)
Executor -> Executor : проверить дескриптор и состояние; зарезервировать отправку
alt Неверный дескриптор или остановка
  Executor --> Submitter : ошибка unexpected(Error)
else Принято
  Executor -> Executor : учесть ожидающую задачу
  Executor -> Queue : enqueue(handle)
  alt Добавление в очередь выполнено
    Executor -> Notifier : уведомить рабочий поток
    Executor --> Submitter : успешно
  else Не удалось добавить в очередь
    Executor -> Executor : освободить учёт ожидающей задачи и отправки
    Executor --> Submitter : ошибка unexpected(Error)
  end
end

== Диспетчеризация ==
Worker -> Dispatcher : возобновить диспетчер
loop Пока не запрошена остановка и принятые задачи не выполнены
  Dispatcher -> Queue : try_dequeue(ConsumerToken)
  alt Дескриптор доступен
    Queue --> Dispatcher : дескриптор
    Dispatcher -> Dispatcher : симметричная передача управления дескриптору
    Dispatcher -> Task : возобновить / выполнять до приостановки
    Task --> Dispatcher : завершение или приостановка
  else Очередь пуста
    Dispatcher -> Notifier : ждать задачу в очереди или остановку
    Notifier --> Dispatcher : пробуждение
  end
end

== Остановка ==
Submitter -> Executor : остановка / уничтожение
Executor -> Executor : закрыть приём задач
Executor -> Notifier : уведомить рабочий поток
Executor --> Submitter : ожидать завершения рабочего потока
Worker -> Dispatcher : выполнить задачи очереди и завершиться
Dispatcher --> Worker : диспетчер завершён
Worker --> Executor : ожидание потока завершено
@enduml
