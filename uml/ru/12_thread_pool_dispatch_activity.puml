@startuml
title ThreadPoolExecutor — алгоритм принятия решений диспетчером

start
while (Запрошена остановка, и у потока нет локальных, служебных или входящих задач?) is (нет)
  :Проверить очередь служебных продолжений;
  if (Доступно служебное продолжение?) then (да)
    :Возобновить выбранную корутину симметричной передачей управления;
  else (нет)
    :Попытаться извлечь задачу из локальной деки Chase–Lev;
    if (Доступна локальная задача?) then (да)
      :Возобновить выбранную корутину симметричной передачей управления;
    else (нет)
      :Проверить счётчик входящих задач и извлечь задачу из глобальной очереди;
      if (Доступна входящая задача?) then (да)
        :Уменьшить счётчик входящих задач;
        :Возобновить выбранную корутину симметричной передачей управления;
      else (нет)
        :Просмотреть очереди соседних потоков в случайном порядке;\nпри успехе забрать одну задачу;
        if (Удалось забрать задачу?) then (да)
          :Возобновить выбранную корутину симметричной передачей управления;
        else (нет)
          :Коротко подождать с паузой процессора;
          if (Появилась задача?) then (да)
            :Повторить планирование;
          else (нет)
            :Зарегистрироваться как спящий поток и ждать поколения уведомителя;
            :Обновить состояние сна / резерва пробуждения;
          endif
        endif
      endif
    endif
  endif
endwhile (да)
stop
@enduml
