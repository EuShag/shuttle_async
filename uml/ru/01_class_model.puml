@startuml
title Модуль async — основные типы и связи
<style>
document {
  BackgroundColor #FFFFFF
}
title {
  FontSize 16
  FontColor #111111
}
</style>
hide empty members

package "shuttle::async" {
  interface IExecutor {
    +execute(handle) : Status
    +currentExecutor() : IExecutor*
    +currentDispatcher() : coroutine_handle
  }

  class ThreadPoolExecutor
  class OneThreadExecutor
  class WorkerContext
  class "WorkerContext::WorkerExecutor" as WorkerExecutor
  class DispatcherTask

  class "AsyncTask<T>" as AsyncTask {
    -coroutine_handle
    -AsyncFuture<T>
    +start(executor) : Status
    +cancel()
    +operator co_await()
  }
  class "AsyncSharedState<T>" as SharedState {
    -result
    -waiter handle
    -waiter executor
    -reference count
    -completion state
  }
  class "AsyncFuture<T>" as AsyncFuture
  class "AsyncPromise<T>" as AsyncPromise
  class "AsyncStatePair<T>" as AsyncStatePair
  class "AsyncStateFactory<T>" as AsyncStateFactory
  class "AsyncResult<T>" as AsyncResult
  class "CancellationToken<T>" as CancellationToken
  class "BlockingTask<T>" as BlockingTask {
    +start(executor) : Status
    +cancel()
    +get()
  }
  class BlockingExecutor {
    +execute(handle) : Status
    +waitForSignal()
  }

  class CoroScope {
    +launch(...)
    +joinTask()
  }
  class JoinableScope {
    +launch(...)
    +joinAll()
  }
  class JointerTask
  class InitialAwaiter
  class FinalAwaiter
  class "Result<T> = std::expected<T, Error>" as Result
  class "Error (enum)" as Error
  class LaunchOptions
  enum LaunchMode {
    Immediate
    Async
    Lazy
  }

  ThreadPoolExecutor ..|> IExecutor
  OneThreadExecutor ..|> IExecutor
  WorkerExecutor ..|> IExecutor
  WorkerContext *-- WorkerExecutor
  ThreadPoolExecutor *-- WorkerContext
  ThreadPoolExecutor ..> DispatcherTask : диспетчер
  OneThreadExecutor ..> DispatcherTask : диспетчер

  AsyncTask *-- AsyncFuture : владеет
  AsyncTask ..> AsyncStatePair : создаёт общие конечные точки завершения
  AsyncStatePair *-- AsyncPromise : конечная точка только для перемещения
  AsyncStatePair *-- AsyncFuture : конечная точка только для перемещения
  AsyncStateFactory ..> SharedState : динамически выделяет память
  AsyncStateFactory ..> AsyncStatePair : возвращает конечные точки
  AsyncPromise ..> SharedState : публикует завершение
  AsyncFuture ..> SharedState : ожидает / получает результат
  AsyncTask ..> InitialAwaiter : начальная приостановка
  AsyncTask ..> FinalAwaiter : финальная передача управления
  AsyncTask ..> CoroScope : контекст запуска
  AsyncTask ..> AsyncResult : ожидание результата
  CancellationToken ..> AsyncTask : наблюдает результат задачи
  BlockingTask *-- AsyncTask : оборачивает
  BlockingTask *-- BlockingExecutor : синхронное ожидание

  JoinableScope --|> CoroScope
  JoinableScope *-- BlockingExecutor : ожидание joinAll
  CoroScope ..> JointerTask : продолжение объединения

  IExecutor ..> Result
  AsyncTask ..> Result
  CoroScope ..> Result
  Result ..> Error
  CoroScope ..> LaunchOptions
  LaunchOptions *-- LaunchMode
}

note right of SharedState
  Состояние динамически выделяется фабрикой,
  а не создаётся напрямую как публичный объект на стеке.
  Переданный вызывающим кодом аллокатор управляет памятью состояния.
  Общее состояние имеет состояния Pending, Suspended
  и Signaled для синхронизации.
  Отмена — отдельный кооперативный флаг,
  а не переход общего состояния.
end note

note right of BlockingExecutor
  Метод execute() у BlockingExecutor сигнализирует
  ожидающему потоку, но не возобновляет корутину.
end note
@enduml
