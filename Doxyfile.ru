PROJECT_NAME           = shuttle_async
PROJECT_BRIEF          = "Задачи на корутинах C++23 и исполнители"
OUTPUT_DIRECTORY       = docs/api/ru
INPUT                  = README.ru.md uml/ru/README.md uml/ru include src
INPUT_ENCODING         = UTF-8
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp *.md
EXCLUDE_PATTERNS       = */external/*
USE_MDFILE_AS_MAINPAGE = README.ru.md
ENABLED_SECTIONS       = RU
OUTPUT_LANGUAGE        = Russian
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
QUIET                  = YES
HAVE_DOT               = NO
